# Copy to .env and fill in. Never commit .env. install.sh writes one for you.
# The setup wizard (/setup/ on the first visit) sets the site name, site URL and theme: leave those three out
# (or commented) when you use it, because values here win over what the wizard saves.
TECHNTING_CMS_DEBUG=0
TECHNTING_CMS_SECRET_KEY=change-me-to-a-long-random-string
TECHNTING_CMS_ALLOWED_HOSTS=cms.example.com
TECHNTING_CMS_CSRF_ORIGINS=https://cms.example.com
# TECHNTING_CMS_SITE_URL=https://example.com
TECHNTING_CMS_ADMIN_URL=https://cms.example.com
# TECHNTING_CMS_SITE_NAME=Technting
TECHNTING_CMS_LEADS_EMAIL=leads@example.com
TECHNTING_CMS_VAR_DIR=/home/technting/technting-cms-var
TECHNTING_CMS_OUTPUT_DIR=/home/technting/htdocs/example.com/public
# TECHNTING_CMS_THEME=technting
TECHNTING_CMS_TIME_ZONE=UTC
# Database: SQLite in TECHNTING_CMS_VAR_DIR unless set (docs/INSTALL.md, "Database"). For mysql (MySQL, MariaDB) or
# postgresql, create the database and its user first and install requirements-mysql.txt or requirements-postgresql.txt.
# TECHNTING_CMS_DB_ENGINE=sqlite
# TECHNTING_CMS_DB_NAME=technting_cms
# TECHNTING_CMS_DB_USER=technting_cms
# TECHNTING_CMS_DB_PASSWORD=change-me
# TECHNTING_CMS_DB_HOST=127.0.0.1
# TECHNTING_CMS_DB_PORT=3306
# Only for deploy/docker/docker-compose.mysql.yml (MariaDB in its own container)
# MARIADB_ROOT_PASSWORD=change-me
# Optional: outgoing email (or set it in the dashboard under Settings -> Email)
# TECHNTING_CMS_SMTP_HOST=smtp.example.com
# TECHNTING_CMS_SMTP_PORT=465
# TECHNTING_CMS_SMTP_SECURITY=ssl
# TECHNTING_CMS_SMTP_USERNAME=
# TECHNTING_CMS_SMTP_PASSWORD=
# Optional: Settings -> Updates installs the published releases from this feed (the default below).
# TECHNTING_CMS_UPDATE_FEED=https://technting.com/wp-json/technting/v1/cms-update
# Optional: update from Git main instead (a read-only deploy key under the ssh alias github-technting-cms).
# TECHNTING_CMS_UPDATE_REMOTE=git@github-technting-cms:owner/repository.git
# Optional: a key the setup wizard asks for once before it opens (install.sh generates one)
# TECHNTING_CMS_SETUP_TOKEN=
# Keep 1 in production. Set 0 only to try the dashboard over plain http on a network address (http://localhost works with 1)
# TECHNTING_CMS_HTTPS=1
# Public demo server: risky actions are refused, email is not sent, and `manage.py demo_reset` rebuilds the demo
# (every 2 hours; see docs/INSTALL.md, "Running a public demo"). The login page shows this shared account.
# TECHNTING_CMS_DEMO_MODE=0
# TECHNTING_CMS_DEMO_USER=demo-user-name
# TECHNTING_CMS_DEMO_PASSWORD=choose-a-demo-password
# Optional: collected dashboard static files (default VAR_DIR/static; the Docker image uses /app/staticfiles)
# TECHNTING_CMS_STATIC_ROOT=
